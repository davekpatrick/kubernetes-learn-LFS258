#
resource "google_dns_record_set" "SOA" {
  count = local.computeInstances
  #
  name = resource.google_dns_managed_zone.dnsZone.dns_name
  type = "SOA"
  ttl  = 21600
  #
  managed_zone = resource.google_dns_managed_zone.dnsZone.name
  #
  rrdatas = [ "ns-cloud-a1.googledomains.com. cloud-dns-hostmaster.google.com. 1 21600 3600 259200 300" ]
}

#
resource "google_dns_record_set" "NS" {
  count = local.computeInstances
  #
  name = resource.google_dns_managed_zone.dnsZone.dns_name
  type = "NS"
  ttl  = 21600
  #
  managed_zone = resource.google_dns_managed_zone.dnsZone.name
  #
  rrdatas = [ "ns-cloud-a1.googledomains.com.", 
              "ns-cloud-a2.googledomains.com.",
              "ns-cloud-a3.googledomains.com.",
              "ns-cloud-a4.googledomains.com."
            ]
}



PATCH https://dns.googleapis.com/dns/v1beta2/projects/dkp-sandbox/managedZones/sandbox/rrsets/sandbox.davekpatrick.dev./SOA

  {
    "rrdatas": [
      "ns-cloud-a1.googledomains.com. cloud-dns-hostmaster.google.com. 1 21600 3600 259200 300"
    ]
  }


## ---------------------------------------------------
## 
## ---------------------------------------------------
resource "local_file" "dnsZoneCfg" {
  # creation dependancy
  depends_on = [google_dns_managed_zone.dnsZone]
  #
  content = <<-EOD
           #BOF
           gcloud auth activate-service-account --key-file auth.json
           gcloud dns record-sets update sandbox.davekpatrick.dev. --type="SOA" --ttl="21600" --zone="sandbox" --rrdatas="ns-cloud-d1.googledomains.com. cloud-dns-hostmaster.google.com. 1 21600 3600 259200 300"
           gcloud dns record-sets update sandbox.davekpatrick.dev. --type="NS" --ttl="21600" --zone="sandbox" --rrdatas="ns-cloud-d1.googledomains.com.,ns-cloud-d2.googledomains.com.,ns-cloud-d3.googledomains.com.,ns-cloud-d4.googledomains.com."
           #EOF
          EOD
  #
  filename        = "dnsZoneCfg.sh"
  file_permission = "0774"
  #
  provisioner "local-exec" {
    command = "./dnsZoneCfg.sh"
  }
}

